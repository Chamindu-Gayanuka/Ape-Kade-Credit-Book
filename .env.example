PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ape_kade_credit_book
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
CLIENT_URL=http://localhost:5173
NODE_ENV=development
# Optional for a separately hosted frontend/PWA; leave empty when /api is reverse-proxied
VITE_API_URL=
# Automatically supplied by Vercel; normally do not set manually
VERCEL_URL=

# Required only for an explicit one-time npm run seed; use unique values.
SEED_ADMIN_USERNAME=
SEED_ADMIN_FULL_NAME=
SEED_CASHIER_1_USERNAME=
SEED_CASHIER_1_FULL_NAME=
SEED_CASHIER_2_USERNAME=
SEED_CASHIER_2_FULL_NAME=
SEED_INITIAL_PASSWORD=